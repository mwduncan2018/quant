# Required
MASSIVE_API_KEY=your_massive_api_key_here

# Strategy universe (comma-separated)
TICKERS=AAPL,AMD,AMZN,AVGO,BABA,BAC,C,CAT,COST,CRM,CVX,DIS,GOOGL,GS,HOOD,INTC,JPM,META,MSFT,MU,NFLX,NVDA,PLTR,PYPL,SOFI,TSLA,UBER,UNH,V,XOM

# Massive REST and local holiday cache
MASSIVE_BASE_URL=https://api.massive.com
REST_CONCURRENCY=5
REST_MAX_RETRIES=2
REST_RATE_LIMIT_ENABLED=true
REST_RATE_LIMIT_REQUESTS=5
REST_RATE_LIMIT_PERIOD_SECONDS=60
HOLIDAY_CACHE_PATH=data/market_holidays.json

# Hot-reloaded manual SPY Gamma Flip
MANUAL_GAMMA_FLIP_PATH=data/manual-options-inputs.json
MANUAL_GAMMA_FLIP_POLL_INTERVAL_SECONDS=1

# Static Daily Implied Move
IMPLIED_MOVE_MULTIPLIER=0.85
ATM_STRIKE_WINDOW_PCT=0.10
CALCULATION_CHECK_INTERVAL_SECONDS=60

# UDP output
UDP_HOST=127.0.0.1
UDP_PORT=5005
UDP_MTU=1400
BROADCAST_INTERVAL_MS=1000

# FastAPI health/debug server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
