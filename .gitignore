# ==========================================
# Unified Trading System .gitignore
# ==========================================

# --- OS Specifics ---
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo

# --- IDEs & Editors ---
.idea/
.vscode/
.history/
*.code-workspace
.metadata/
.recommenders/
.factorypath
.project
.classpath
.settings/
*.launch

# --- Java & Maven (trading-engine & JavaClient) ---
target/
bin/
.mvn/
mvnw
mvnw.cmd
dependency-reduced-pom.xml
*.class
*.jar
*.war
*.ear

# --- Python & uv (options-proxy) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.uv/
.uv-cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
.cache
.mypy_cache/

# --- Node / Frontend (trading-dashboard) ---
node_modules/
dist/
build/
.next/
out/

# --- IBKR / TWS Specifics ---
jts.ini
tws.xml
logs/

# --- Runtime Data & Caches ---
# Prevent committing live account states, logs, and volatile caches
*.log
data/trading-state*.json
data/trading-state*.json.tmp
data/market_holidays.json
data/manual-options-inputs.json
data/earnings-dates.json

# --- Secrets & Cloud Keys ---
secrets/
config/credentials.properties
*.pem
*.key
*.pub
# (Note: Be careful not to globally ignore *.json if you have JSON config files. 
# If you keep service accounts in JSON, keep them in the secrets/ folder)

# --- Agentic Workspace (Antigravity & AI Tools) ---
# We track rules and custom skills, but ignore runtime AI data
.agent/logs/
.agent/temp/
.agent/cache/
.agent/state/
.gemini/
mcp.json
