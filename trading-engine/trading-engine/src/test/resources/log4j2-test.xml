<?xml version="1.0" encoding="UTF-8"?>
<!--
    Console only. Tests must not create or roll the engine's log files, and a
    surefire fork should not be writing into the same directory a live PAPER
    session might be using.
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
